{
  "description": "Qualixar Jev Codex Workbench 1.1.3: standing workspace operation; legacy mode outside enrollment.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/jev_policy_hook.py\"",
            "timeout": 40
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/jev_policy_hook.py\"",
            "timeout": 40
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/jev_policy_hook.py\"",
            "timeout": 40
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/jev_policy_hook.py\"",
            "timeout": 40
          }
        ],
        "matcher": "^(Bash|apply_patch|Edit|Write)$"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/jev_policy_hook.py\"",
            "timeout": 40
          }
        ],
        "matcher": "^(Bash|Read|Grep|.*jev_evaluate)$"
      }
    ]
  }
}
