# Private configuration template. Do not put a populated copy in this repository.
# Manual setup path: ~/.config/qualixar-jev-control/.env
# Required permissions: directory 0700, file 0600.
# Select exactly one Jev provider.
JEV_PROVIDER=openrouter

# Fill only the key for the selected provider. The interactive installer is safer:
# it accepts the key without echoing it and writes equivalent owner-only files.
OPENROUTER_API_KEY=
TYPESAFE_API_KEY=
